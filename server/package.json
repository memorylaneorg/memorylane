{
  "name": "@memorylane/server",
  "version": "1.0.6",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-version.mjs && tsx watch src/server.ts",
    "build": "node scripts/generate-version.mjs && tsc -p tsconfig.json && node scripts/copy-migrations.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "reset-password": "tsx scripts/reset-password.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.1",
    "@fastify/static": "^8.0.1",
    "@memorylane/plugin-sdk": "*",
    "@memorylane/shared": "*",
    "argon2": "^0.41.1",
    "better-sqlite3": "^11.3.0",
    "bmp-js": "^0.1.0",
    "dotenv": "^16.4.5",
    "exiftool-vendored": "^28.4.0",
    "extract-zip": "^2.0.1",
    "fastify": "^5.0.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "nanoid": "^5.0.7",
    "open": "^10.1.0",
    "p-limit": "^6.1.0",
    "pino-pretty": "^11.2.2",
    "sharp": "^0.33.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/bmp-js": "^0.1.2",
    "@types/node": "^22.7.4",
    "pino": "^9.4.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
