# Server
# MEMORYLANE_DATA_DIR=
# MEMORYLANE_PORT=4280
# MEMORYLANE_BIND_ADDRESS=127.0.0.1
# MEMORYLANE_ALLOW_REMOTE_SETUP=0
# MEMORYLANE_NO_OPEN=0
# LOG_LEVEL=info

# Plugin development and self-hosted catalogs. Leave blank to use the source-tree dev catalog.
# MEMORYLANE_PLUGIN_DIR=
# MEMORYLANE_PLUGIN_CATALOG_URL=
# MEMORYLANE_BUNDLED_PLUGIN_REPOSITORY=
# MEMORYLANE_PLUGIN_PUBLIC_KEY=
# MEMORYLANE_PLUGIN_ALLOW_HTTP=0

# Optional AI runtime development
# The server expects a stable model ID while the standalone runtime accepts a
# Hugging Face repository. Leave unset unless developing model selection.
# MEMORYLANE_AI_MODEL=clip-vit-base-patch32@1
# MEMORYLANE_AI_FACE_MODEL=yunet-sface
# MEMORYLANE_AI_DEVICE=cpu
# MEMORYLANE_AI_MAX_BATCH=32
# MEMORYLANE_AI_HOST=127.0.0.1
# MEMORYLANE_AI_PORT=4281
# MEMORYLANE_AI_TOKEN=

# Desktop development
# MEMORYLANE_UPDATE_FEED_URL=
# MEMORYLANE_RUNTIME_DIR=
# MEMORYLANE_TRAY_DATA_DIR=
# MEMORYLANE_TRAY_NO_AUTOSTART=0

# Optional Camera Museum service override
# MEMORYLANE_MUSEUM_URL=http://127.0.0.1:4282
