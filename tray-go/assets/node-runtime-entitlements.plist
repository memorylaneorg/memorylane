<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Node's V8 engine generates machine code at runtime. Without this,
       hardened-runtime builds trap during V8 initialization on macOS. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <!-- Native npm addons are separately signed nested code. Node must be able
       to dlopen them even when their signing identity differs from Node's. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
